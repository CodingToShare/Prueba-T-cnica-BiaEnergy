# Local development placeholders only - never real credentials.
# Copy to .env (ignored by Git) to override the compose.yaml defaults.
# docker compose reads the POSTGRES_* values; the Go commands read
# DATABASE_URL, HTTP_ADDR, LOG_LEVEL and (API only) the authentication
# settings below from the process environment.

POSTGRES_DB=bia_energy
POSTGRES_USER=bia
POSTGRES_PASSWORD=bia_local_dev
POSTGRES_PORT=5432

DATABASE_URL=postgres://bia:bia_local_dev@localhost:5432/bia_energy?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info

# API demo authentication (local placeholders only). The API refuses to start
# without them. SESSION_COOKIE_SECURE defaults to true; false is only for
# plain-HTTP local development.
DEMO_AUTH_USERNAME=demo
DEMO_AUTH_PASSWORD=change-me-locally
SESSION_SIGNING_KEY=replace-with-a-local-development-key
SESSION_COOKIE_SECURE=false

# Finding explanations (API only). deterministic (default) needs nothing else
# and makes no network call. ollama uses a local Ollama server; if it is
# unavailable or its output is rejected, the deterministic text is used and
# the analysis still completes. OLLAMA_MODEL is required with ollama.
EXPLANATION_PROVIDER=deterministic
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT=60s
