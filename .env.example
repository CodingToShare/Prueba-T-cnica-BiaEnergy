# Bia Energy environment contract. LOCAL-DEMO VALUES ONLY: none of these is a
# production credential. Never commit a real .env (it is ignored by Git).
#
# Compose demo (`docker compose up --build -d --wait`) needs NO .env: every
# value below has the same default in compose.yaml. Copy this file to .env
# only to override something (Compose reads .env from the repository root).
# Manual host execution (Go commands and Next.js on this machine) reads the
# same names from the process environment; see README "Manual development".

# --- PostgreSQL (Compose service and host port) ---
POSTGRES_DB=bia_energy
POSTGRES_USER=bia
POSTGRES_PASSWORD=bia_local_dev
POSTGRES_PORT=5432

# --- Published ports of the demo stack (127.0.0.1 only) ---
API_PORT=8080
WEB_PORT=3000

# --- Go commands on the host (Compose builds its own internal URL) ---
DATABASE_URL=postgres://bia:bia_local_dev@localhost:5432/bia_energy?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info

# --- API demo login and session (required by the API) ---
# SESSION_COOKIE_SECURE=false only because the demo is plain HTTP on
# localhost; a real deployment serves HTTPS and keeps it true.
DEMO_AUTH_USERNAME=demo
DEMO_AUTH_PASSWORD=bia-demo-2026
SESSION_SIGNING_KEY=local-demo-only-signing-key-not-for-production
SESSION_COOKIE_SECURE=false

# --- Finding explanations (optional) ---
# deterministic (default) needs no model and makes no network call.
# ollama uses a local Ollama server; if it is unavailable or its output is
# rejected, the deterministic text is used and the analysis still completes.
EXPLANATION_PROVIDER=deterministic
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT=60s
# Where the API reaches Ollama. Compose default: http://host.docker.internal:11434
# (Ollama on this machine). For an API running on the host: http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
