root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# Go: gofmt uses tabs
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum,go.work}]
indent_style = tab

[Makefile]
indent_style = tab

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 4

[*.sh]
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break
trim_trailing_whitespace = false

# Source datasets are kept byte-for-byte
[data/input/*.csv]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
charset = unset
